+.activity-page .chat-content {
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  height: calc(100dvh - 112px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
+  min-height: 0;
+  overflow: hidden;
+  padding: 20px 16px 0;
+}
+
+.activity-page .chat-messages {
+  flex: 1 1 auto;
+  min-height: 0;
+  max-height: none;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  padding: 4px 2px 14px;
+}
+
+.activity-page .chat-loading {
+  display: grid;
+  place-items: center;
+  min-height: 200px;
+}
+
+.activity-page .chat-load-more {
+  display: block;
+  margin: 0 auto 12px;
+  border: 0;
+  color: var(--activity-gold);
+  background: transparent;
+  font-size: 12px;
+}
+
+.activity-page .chat-empty {
+  margin: 24px 0;
+  color: var(--activity-text-muted);
+  text-align: center;
+}
+
+.activity-page .chat-message {
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  width: 100%;
+  margin: 0 0 12px;
+  padding: 0;
+  background: transparent;
+}
+
+.activity-page .chat-message .activity-avatar {
+  width: 36px;
+  height: 36px;
+  margin-top: 18px;
+}
+
+.activity-page .chat-message--self {
+  flex-direction: row-reverse;
+}
+
+.activity-page .chat-message-content {
+  display: flex;
+  flex: 0 1 auto;
+  flex-direction: column;
+  min-width: 0;
+  max-width: min(78%, 520px);
+}
+
+.activity-page .chat-message--self .chat-message-content { align-items: flex-end; }
+
+.activity-page .chat-message-meta {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 12px;
+  max-width: 100%;
+  margin: 0 4px 4px;
+  color: var(--activity-gold-strong);
+  font-size: 12px;
+}
+
+.activity-page .chat-message-meta strong {
+  min-width: 0;
+  overflow-wrap: anywhere;
