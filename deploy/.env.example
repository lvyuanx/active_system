# Nginx 和后端只在 open-getaway-network 内提供 8080/8000，由外部网关统一对外暴露。
SUPERUSER_USERNAME=admin
# 必填：管理员密码建议至少 12 字符、JWT 随机密钥至少 32 字符、安全码至少 6 字符。
SUPERUSER_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
LOTTERY_SECURITY_CODE=
# 可选：为空时沿用 JWT_SECRET。
DANMAKU_TOKEN_SECRET=
# 前端默认走同源 /api，无需配置 CORS；直接跨端口请求 API 时填写允许的来源。
APP_CORS_ORIGINS=
# 阿里云短信使用默认凭据链；填写 AccessKey 或配置运行环境的 RAM 角色。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_VALID_TIME=300
# 微信小程序码生成配置；AppSecret 只配置在后端，不要提交到代码仓库。
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=
WECHAT_MINIAPP_PAGE=pages/entry/index
