# Strict literal KEY=value: no quotes, spaces, dollar signs or shell expressions.
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=CHANGE_ME_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_CHARACTERS
LOTTERY_SECURITY_CODE=CHANGE_ME_SECURITY_CODE
HTTP_PORT=80
# Optional CORS origins, comma-separated. Same-origin deployment needs none.
APP_CORS_ORIGINS=
