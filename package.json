{
  "name": "active-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @active/admin-web --filter @active/screen-web --filter @active/user-web dev",
    "dev:admin": "pnpm --filter @active/admin-web dev",
    "dev:screen": "pnpm --filter @active/screen-web dev",
    "dev:user": "pnpm --filter @active/user-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "generate:api": "powershell -ExecutionPolicy Bypass -File scripts/generate-api.ps1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.8.0"
  }
}
