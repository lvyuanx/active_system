APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
VITE_API_BASE_URL=http://localhost:8000/api/v1
