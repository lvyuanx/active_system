.home-page {
  min-height: 100vh;
}

.home-content {
  padding-top: 40rpx;
}

.home-hero {
  padding: 42rpx 40rpx 44rpx;
  border: 1px solid #303433;
  border-radius: 32rpx;
  background: #151819;
}

.home-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.home-kicker {
  color: #8f918d;
  letter-spacing: 2rpx;
}

.home-profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-width: 0;
  margin-top: 36rpx;
}

.home-profile-copy {
  min-width: 0;
  flex: 1;
}

.home-title {
  display: block;
  color: #f5f2eb;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.home-description {
  display: block;
  margin-top: 14rpx;
  color: #c8c4bb;
  font-size: 28rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1px solid #303433;
  color: #8f918d;
  font-size: 24rpx;
  line-height: 1.4;
}

.activity-meta__name {
  color: #e7ca86;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.service-section {
  margin-top: 52rpx;
}

.service-list {
  margin-top: 26rpx;
  overflow: hidden;
  border: 1px solid #303433;
  border-radius: 26rpx;
  background: #151819;
}

.service-cell {
  display: flex;
  min-height: 142rpx;
  align-items: center;
  width: 100%;
  padding: 24rpx 28rpx;
  border-bottom: 1px solid #303433;
  border-radius: 0;
  color: #f5f2eb;
  background: transparent;
  text-align: left;
}

.service-cell:last-child {
  border-bottom: 0;
}

.service-cell:active {
  background: #1b1e1f;
}

.service-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  margin-right: 24rpx;
  border: 1px solid #80663a;
  border-radius: 20rpx;
  color: #e7ca86;
  background: #302d23;
  font-size: 38rpx;
}

.service-copy {
  min-width: 0;
  flex: 1;
}

.service-title,
.service-label {
  display: block;
  overflow-wrap: anywhere;
}

.service-title {
  color: #f5f2eb;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.service-label {
  margin-top: 8rpx;
  color: #8f918d;
  font-size: 24rpx;
  line-height: 1.5;
}

.service-arrow {
  margin-left: 20rpx;
  color: #8f918d;
  font-size: 48rpx;
  line-height: 1;
}
