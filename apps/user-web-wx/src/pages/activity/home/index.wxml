<view class="wx-page home-page" style="padding-top: {{statusBarHeight}}px;">
  <block wx:if="{{loading}}">
    <view class="state-page">
      <view class="state-page__inner">
        <view class="state-symbol">...</view>
        <text class="state-title">正在加载活动</text>
      </view>
    </view>
  </block>
  <block wx:elif="{{error}}">
    <view class="state-page">
      <view class="state-page__inner">
        <view class="state-symbol state-symbol--error">!</view>
        <text class="state-title">暂时无法进入活动</text>
        <text class="state-message">{{error}}</text>
        <button class="primary-button" bindtap="load">重新加载</button>
      </view>
    </view>
  </block>
  <block wx:elif="{{activity && user}}">
    <scroll-view class="page-scroll" scroll-y="true">
      <view class="page-content home-content">
        <view class="home-hero">
          <view class="home-hero-top">
            <text class="section-kicker home-kicker">活动空间</text>
            <text class="tag {{statusClass}}">{{statusLabel}}</text>
          </view>
          <view class="home-profile">
            <activity-avatar avatar-id="{{user.avatar_id}}" alt="{{user.username}}的活动头像" />
            <view class="home-profile-copy">
              <text class="home-title">你好，{{user.username}}</text>
              <text class="home-description">{{activity.description || "活动内容即将开始，敬请期待。"}}</text>
            </view>
          </view>
          <view class="activity-meta">
            <text>当前活动</text>
            <text class="activity-meta__name">{{activity.name || "活动入口"}}</text>
          </view>
        </view>

        <view class="service-section">
          <view class="section-heading">
            <view><text class="section-kicker">参与服务</text><text class="section-title">活动服务</text></view>
            <text class="section-count">{{serviceCount}} 项</text>
          </view>
          <view class="service-list">
            <view class="service-cell" bindtap="goLotteryResults">
              <view class="service-icon">✦</view>
              <view class="service-copy">
                <text class="service-title">抽奖活动</text>
                <text class="service-label">查看奖品和中奖结果</text>
              </view>
              <text class="service-arrow">›</text>
            </view>
            <view class="service-cell" bindtap="goChat">
              <view class="service-icon">◌</view>
              <view class="service-copy">
                <text class="service-title">活动聊天室</text>
                <text class="service-label">与同场活动参与者实时交流</text>
              </view>
              <text class="service-arrow">›</text>
            </view>
            <view wx:if="{{user.can_mobile_lottery}}" class="service-cell" bindtap="goLottery">
              <view class="service-icon">◇</view>
              <view class="service-copy">
                <text class="service-title">抽奖控制</text>
                <text class="service-label">切换奖品并发起抽奖</text>
              </view>
              <text class="service-arrow">›</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>
</view>
