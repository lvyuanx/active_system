<view class="wx-page results-page" style="padding-top: {{statusBarHeight}}px;">
  <scroll-view class="page-scroll" scroll-y="true">
    <view class="page-content results-content">
      <view class="sub-header">
        <view class="back-button" bindtap="goHome">‹</view>
        <view class="sub-header__copy">
          <text class="section-kicker">PRIZE ACTIVITY</text>
          <text class="sub-title">抽奖活动</text>
        </view>
        <text class="tag {{connectionClass}}">{{connectionLabel}}</text>
      </view>

      <block wx:if="{{loading}}">
        <view class="inline-state">
          <view class="state-symbol">...</view>
          <text>正在加载抽奖活动</text>
        </view>
      </block>
      <block wx:elif="{{error}}">
        <view class="inline-state inline-state--error">
          <view class="state-symbol state-symbol--error">!</view>
          <text>{{error}}</text>
          <button class="retry-button" bindtap="load">重新连接</button>
        </view>
      </block>
      <block wx:else>
        <view class="section-heading section-heading--results">
          <view>
            <text class="section-kicker">PRIZE BOARD</text>
            <text class="section-title">奖品展示</text>
          </view>
          <text class="tag {{activityClass}}">{{activityStatusLabel}}</text>
        </view>

        <swiper
          wx:if="{{prizes.length}}"
          class="prize-swiper"
          current="{{activeIndex}}"
          circular="{{prizes.length > 1}}"
          indicator-dots="true"
          indicator-color="#4b463a"
          indicator-active-color="#e7ca86"
          bindchange="handleSlideChange"
        >
          <swiper-item wx:for="{{prizes}}" wx:key="prize_id">
            <view class="prize-slide">
              <view class="prize-image-wrap">
                <image
                  wx:if="{{item.showImage}}"
                  class="prize-image"
                  src="{{item.imageURL}}"
                  mode="aspectFill"
                  binderror="markImageFailed"
                  data-url="{{item.image_url}}"
                />
                <text wx:else class="prize-image-fallback">✦</text>
              </view>
              <view class="prize-copy">
                <text class="prize-award">{{item.award_name}}</text>
                <text class="prize-name">{{item.name}}</text>
                <text class="prize-index">{{index + 1}} / {{prizes.length}}</text>
              </view>
            </view>
          </swiper-item>
        </swiper>
        <view wx:else class="empty-box">暂无启用奖品</view>

        <view wx:if="{{currentPrize}}" class="prize-info">
          <view class="info-heading">
            <view>
              <text class="section-kicker">PRIZE INFO</text>
              <text class="info-title">{{currentPrize.name}}</text>
            </view>
            <text class="tag {{currentPrizeClass}}">{{currentPrizeStatusLabel}}</text>
          </view>
          <text class="prize-award">{{currentPrize.award_name}}</text>
          <view class="stats">
            <text>总数 {{currentPrize.quantity}} 份</text>
            <text>剩余 {{currentPrize.remaining_quantity}} 份</text>
            <text>已中奖 {{currentDraws.length}} 人</text>
          </view>
          <view class="winner-section">
            <view class="winner-heading">
              <text class="section-kicker">WINNERS</text>
              <text>中奖人</text>
            </view>
            <view wx:if="{{currentDraws.length}}" class="winner-list">
              <view wx:for="{{currentDraws}}" wx:key="draw_id" class="winner-row">
                <text>第 {{item.draw_number}} 位</text>
                <text class="winner-name">{{item.winner.username}}</text>
              </view>
            </view>
            <text wx:else class="no-winner">{{noWinnerLabel}}</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
