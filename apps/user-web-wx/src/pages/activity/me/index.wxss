.me-content {
  padding-top: 40rpx;
}

.me-hero {
  padding: 42rpx 40rpx;
  border: 1px solid #303433;
  border-radius: 32rpx;
  background: #151819;
}

.me-profile {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  min-width: 0;
}

.me-profile-copy {
  min-width: 0;
  flex: 1;
}

.me-title {
  display: block;
  margin-top: 18rpx;
  color: #f5f2eb;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.me-description {
  display: block;
  margin-top: 12rpx;
  color: #c8c4bb;
  font-size: 28rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.me-list {
  margin-top: 40rpx;
  overflow: hidden;
  border: 1px solid #303433;
  border-radius: 26rpx;
  background: #151819;
}

.policy-list {
  margin-top: 28rpx;
  overflow: hidden;
  border: 1px solid #303433;
  border-radius: 26rpx;
  background: #151819;
}

.policy-cell {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1px solid #303433;
  color: #c8c4bb;
  font-size: 28rpx;
  line-height: 1.5;
}

.policy-cell:last-child {
  border-bottom: 0;
}

.policy-arrow {
  color: #d5b36b;
  font-size: 24rpx;
}

.me-cell {
  display: flex;
  min-height: 98rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1px solid #303433;
  color: #c8c4bb;
  font-size: 28rpx;
  line-height: 1.5;
}

.me-cell:last-child {
  border-bottom: 0;
}

.me-value {
  min-width: 0;
  color: #f5f2eb;
  text-align: right;
  overflow-wrap: anywhere;
}

.logout-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  margin-top: 42rpx;
  border: 1px solid #d5b36b;
  border-radius: 20rpx;
  color: #e7ca86;
  background: transparent;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 92rpx;
}
